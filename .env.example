# Root env example — prefer configuring the backend via backend/.env
# Copy Phoenix vars into backend/.env for the running API.

# Arize Phoenix Configurations
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
PHOENIX_PROJECT_NAME="ai-policy-foundry"
PHOENIX_CLIENT_HEADERS="" # Format: api_key=your_key (Leave blank for local)

# Mixpanel (synthetic import / analytics)
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_PASS=
MIXPANEL_PROJECT_ID=
