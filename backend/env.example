# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_policy_foundry
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Enhanced Agent Configuration
USE_ENHANCED_AGENTS=true
USE_LANGGRAPH=true
USE_RAG=true

# Vector Database Configuration (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-west1-gcp

# Alternative Vector Database (FAISS - for development)
# FAISS_INDEX_PATH=./faiss-index

# Knowledge Base Configuration
KNOWLEDGE_BASE_UPDATE_INTERVAL=3600000
KNOWLEDGE_BASE_MAX_DOCUMENTS=10000

# MCP (Model Context Protocol) Configuration
USE_MCP_AGENTS=true

# Document Server Configuration
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS=
SHAREPOINT_ENABLED=false
SHAREPOINT_CREDENTIALS=
FILESYSTEM_BASE_PATH=./documents

# Cloud Provider MCP Configuration
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

GCP_ENABLED=false
GCP_PROJECT_ID=
GCP_KEY_FILENAME=

# Git MCP Configuration
GIT_ENABLED=true
GIT_REPOSITORY_PATH=./policies

# External Integration MCP Configuration
SIEM_ENABLED=false
SIEM_TYPE=splunk
SIEM_URL=
SIEM_API_KEY=

TICKETING_ENABLED=false
TICKETING_TYPE=jira
TICKETING_URL=
TICKETING_API_KEY=
TICKETING_PROJECT_KEY=POL

COMMUNICATION_ENABLED=false
COMMUNICATION_TYPE=slack
COMMUNICATION_WEBHOOK_URL= 