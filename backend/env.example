# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (Vite serves on 8080)
FRONTEND_URL=http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_policy_foundry
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OpenRouter Configuration (required for live LLM generation)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=AI Policy Foundry

# Deprecated: only used if OPENROUTER_API_KEY is unset
# OPENAI_API_KEY=

# Arize Phoenix Configurations (LLM observability + eval)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=ai-policy-foundry
PHOENIX_CLIENT_HEADERS=
# Format: api_key=your_key (leave blank for local Phoenix)
PHOENIX_TRACING_ENABLED=true
# PHOENIX_SPAN_PROCESSOR=simple
# PHOENIX_OTEL_DEBUG=false

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Mixpanel (synthetic import / analytics)
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_PASS=
MIXPANEL_PROJECT_ID=
